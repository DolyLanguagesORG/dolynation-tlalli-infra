# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=dolynglish_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=dolynglish_test

# ─────────────────────────────────────────────────────────────────────────
# Stack de STAGING / PRODUCCION / REHEARSAL (docker-compose.env.yml)
#
# Este NO es el .env de desarrollo: es el de un ambiente desplegado por
# imagen. El workflow de despliegue lo escribe en el servidor a partir de los
# secrets del GitHub Environment correspondiente; aqui solo esta la forma.
#
# Los valores de POSTGRES_PASSWORD, DB_PASSWORD y JWT_SECRET son PROPIOS de
# cada ambiente: un token de staging no tiene que valer en produccion.
# ─────────────────────────────────────────────────────────────────────────

# Nombre del proyecto: define el prefijo de los contenedores, de la red y
# del volumen de datos. Cada ambiente tiene el suyo.
COMPOSE_PROJECT_NAME=doly-staging

# Puertos en el host. Solo en 127.0.0.1: el unico que llega a los
# contenedores es el proxy (nginx) de este servidor.
#   5702x = staging, 5703x = produccion, 5704x = rehearsal
DB_HOST_PORT=57020
BACKEND_HOST_PORT=57021
FRONTEND_HOST_PORT=57022

# Etiqueta de la imagen del backend. Es el SHA del commit: inmutable, es lo
# que corre y lo que permite hacer rollback. La imagen del frontend se
# despliega por version (lo decide deploy-env.sh leyendo el manifiesto).
IMAGE_TAG=latest

# Correo (SMTP). Opcionales: el backend arranca sin ellas y el servicio de
# correo falla con un mensaje claro si se usa sin configurar. El valor de cada
# ambiente vive en su GitHub Environment (lo pone el scrum master).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=usuario-del-ambiente
SMTP_PASSWORD=clave-del-ambiente
SMTP_FROM=DolyNation <usuario-del-ambiente>
SMTP_FROM_NAME=DolyNation
SMTP_SECURE=false

# Base de datos del ambiente
POSTGRES_USER=dolynglish_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dolynglish
DB_USER=dolynglish_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=dolynglish

# Autenticacion. Minimo 32 caracteres.
JWT_SECRET=your_jwt_secret_de_32_caracteres_minimo_aqui
JWT_ACCESS_TTL=5m
JWT_REFRESH_TTL=30d

# Proveedor de IA
AI_DEFAULT_PROVIDER=minimax
MINIMAX_API_KEY=your_api_key_here
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_REASONING_EFFORT=low

# Proveedor Google (Gemini + gemini-decision-1). Opcional: sin la key el
# backend arranca igual y el proveedor lanza
# "GOOGLE_API_KEY is not configured" cuando se usa.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-3.5-flash-lite

# Moderacion de categorias dinamicas. Los proveedores externos son
# opcionales; el modo `auto` usa el que este disponible.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODERATION_ENDPOINT=https://api.openai.com/v1/moderations
OPENAI_MODERATION_MODEL=omni-moderation-latest
CATEGORY_MODERATION_ENABLED=true
CATEGORY_MODERATION_AI_ENABLED=true
# auto | openai | google-decisions | minimax | google | none
CATEGORY_MODERATION_AI_PROVIDER=auto
CATEGORY_DAILY_LIMIT=20
CATEGORY_MODERATION_SCORE_THRESHOLD=0.45
CATEGORY_MODERATION_TIMEOUT_MS=15000
CATEGORY_MODERATION_CACHE_TTL_MS=86400000

# Base publica del frontend (para los enlaces de los correos) y exigencia de
# confirmar el correo antes de iniciar sesion.
FRONTEND_BASE_URL=https://yacaterkos.tech
EMAIL_VERIFICATION_REQUIRED=true
ACCESS_REQUESTS_ENABLED=true
ADMIN_NOTIFICATION_EMAIL=

# Pasarela de pagos (Stripe Sandbox / manual)
BILLING_PROVIDER=manual
BILLING_ENV_TAG=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=mxn
STRIPE_CHECKOUT_UI_MODE=custom
STRIPE_PRICE_DOLLY=
STRIPE_PRICE_DOLLY_PLUS=
STRIPE_PRICE_DOLLY_PRO=
STRIPE_PRICE_LANGUAGE_UNLOCK=

# App
TZ=America/Mexico_City
LOG_LEVEL=info
API_PREFIX=api/v1
