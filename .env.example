# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=dolynglish_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=dolynglish_test

# ─────────────────────────────────────────────────────────────────────────
# Stack de STAGING / PRODUCCION / REHEARSAL (docker-compose.env.yml)
#
# Este NO es el .env de desarrollo: es el de un ambiente desplegado por
# imagen. El workflow de despliegue lo escribe en el servidor a partir de los
# secrets del GitHub Environment correspondiente; aqui solo esta la forma.
#
# Los valores de POSTGRES_PASSWORD, DB_PASSWORD y JWT_SECRET son PROPIOS de
# cada ambiente: un token de staging no tiene que valer en produccion.
# ─────────────────────────────────────────────────────────────────────────

# Nombre del proyecto: define el prefijo de los contenedores, de la red y
# del volumen de datos. Cada ambiente tiene el suyo.
COMPOSE_PROJECT_NAME=doly-staging

# Puertos en el host. Solo en 127.0.0.1: el unico que llega a los
# contenedores es el proxy (nginx) de este servidor.
#   5702x = staging, 5703x = produccion, 5704x = rehearsal
DB_HOST_PORT=57020
BACKEND_HOST_PORT=57021
FRONTEND_HOST_PORT=57022

# Etiqueta de la imagen del backend. Es el SHA del commit: inmutable, es lo
# que corre y lo que permite hacer rollback. La imagen del frontend se
# despliega por version (lo decide deploy-env.sh leyendo el manifiesto).
IMAGE_TAG=latest

# Base de datos del ambiente
POSTGRES_USER=dolynglish_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dolynglish
DB_USER=dolynglish_user
DB_PASSWORD=your_secure_password_here
DB_DATABASE=dolynglish

# Autenticacion. Minimo 32 caracteres.
JWT_SECRET=your_jwt_secret_de_32_caracteres_minimo_aqui
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Proveedor de IA
AI_DEFAULT_PROVIDER=minimax
MINIMAX_API_KEY=your_api_key_here
MINIMAX_MODEL=MiniMax-M3

# App
TZ=America/Mexico_City
LOG_LEVEL=info
API_PREFIX=api/v1
