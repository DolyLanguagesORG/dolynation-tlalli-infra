# Variables del stack de DESARROLLO (docker-compose.dev.yml).
# En el servidor este archivo se guarda como `.env` y lo regenera el
# workflow `deploy-dev.yml` desde los secretos del environment `desarrollo`.
# NO se commitea (`.env` está en .gitignore).

POSTGRES_USER=dolynglish_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dolynglish
