# Peer de MinIO de DolyNation.
#
# La imagen oficial minio/minio de Docker Hub esta restringida (401) y la
# de quay tambien. Se construye desde el binario oficial publicado por
# MinIO en sus releases de GitHub, verificado con su SHA256: el codigo es
# el oficial, sin intermediarios.
#
# El peer corre en su propia red y solo se alcanza por la VPN.

FROM alpine:3.20

RUN apk add --no-cache \
      wireguard-tools \
      nginx \
      bash \
      gettext \
      iptables \
      ca-certificates \
      curl \
 && update-ca-certificates

ARG MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_SHA256=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d

RUN wget -q -O /usr/local/bin/minio \
      "https://github.com/minio/minio/releases/download/${MINIO_VERSION}/minio.linux-arm64.${MINIO_VERSION}" \
 && echo "${MINIO_SHA256}  /usr/local/bin/minio" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/minio

COPY entrypoint.minio.sh /usr/local/bin/entrypoint.sh
COPY nginx.conf.template /etc/nginx/nginx.conf.template

RUN chmod 0755 /usr/local/bin/entrypoint.sh

ENV MINIO_VOLUMES=/data
ENV MINIO_OPTS="--console-address :9001"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
